# --- Composio ---
# Get your API key from https://app.composio.dev/settings
COMPOSIO_API_KEY=

# Create a Gmail auth config in the Composio dashboard (Toolkits -> Gmail ->
# Create Auth Config) and paste its ID here. All users authenticate against
# this single auth config, each producing their own connected account.
COMPOSIO_GMAIL_AUTH_CONFIG_ID=

# Optional: where Composio redirects the user after OAuth. Leave blank to
# use Composio's default hosted callback page.
COMPOSIO_CALLBACK_URL=

# --- Gemini ---
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Batching ---
FETCH_BATCH_SIZE=100
CLASSIFY_BATCH_SIZE=20
MAX_MESSAGES_PER_SCAN=2000
GMAIL_RETRY_ATTEMPTS=3
GMAIL_RETRY_BACKOFF_SECONDS=2.0

# --- Safety ---
DRY_RUN_DEFAULT=true
CONFIDENCE_HIGH=0.90
CONFIDENCE_LOW=0.70
